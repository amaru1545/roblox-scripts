--========================================================
-- DRAG GUI
--========================================================

track(title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end))

track(title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end))

track(UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input == dragInput
        or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

--========================================================
-- GAP CONTROLS
--========================================================

track(minus.Activated:Connect(function()
    gap = math.max(MIN_GAP, gap - 1)
    gapLabel.Text = "Gap: " .. gap .. " studs"
end))

track(plus.Activated:Connect(function()
    gap = math.min(MAX_GAP, gap + 1)
    gapLabel.Text = "Gap: " .. gap .. " studs"
end))

--========================================================
-- PLATFORM
--========================================================

local function destroyPlatform()
    if platform then
        platform:Destroy()
        platform = nil
    end
end

local function createPlatform()
    destroyPlatform()

    platform = Instance.new("Part")
    platform.Name = "LocalFollowPlatform"
    platform.Size = PLATFORM_SIZE
    platform.Anchored = true
    platform.CanCollide = true
    platform.CanTouch = false
    platform.CanQuery = false
    platform.Transparency = PLATFORM_TRANSPARENCY
    platform.Material = Enum.Material.SmoothPlastic
    platform.Color = Color3.fromRGB(255, 145, 65)
    platform.CastShadow = false
    platform.Parent = workspace
end

--========================================================
-- STOP FOLLOWING
--========================================================

local function stopFollowing()
    enabled = false
    sideInput = 0
    jumping = false

    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end

    destroyPlatform()

    if root and root.Parent and originalCFrame then
        root.CFrame = originalCFrame
        root.AssemblyLinearVelocity = Vector3.zero
    end

    local camera = workspace.CurrentCamera

    if camera then
        camera.CameraType = originalCameraType or Enum.CameraType.Custom

        if humanoid and humanoid.Parent then
            camera.CameraSubject = humanoid
        elseif originalCameraSubject and originalCameraSubject.Parent then
            camera.CameraSubject = originalCameraSubject
        end
    end

    if humanoid and humanoid.Parent and originalAutoRotate ~= nil then
        humanoid.AutoRotate = originalAutoRotate
    end

    originalCFrame = nil
    originalAutoRotate = nil
    originalCameraType = nil
    originalCameraSubject = nil
    lockedHeight = nil

    toggle.Text = "ENABLE FOLLOW"
    toggle.BackgroundColor3 = Color3.fromRGB(40, 145, 85)
    status.Text = "Status: OFF"
end

--========================================================
-- START FOLLOWING
--========================================================

local function startFollowing()
    if not root or not root.Parent
        or not humanoid or humanoid.Health <= 0 then
        status.Text = "Status: CHARACTER NOT READY"
        return
    end

    local hitbox = getHitbox()

    if not hitbox then
        status.Text = "Status: HITBOX NOT FOUND"
        return
    end

    local camera = workspace.CurrentCamera

    originalCFrame = root.CFrame
    originalAutoRotate = humanoid.AutoRotate

    if camera then
        originalCameraType = camera.CameraType
        originalCameraSubject = camera.CameraSubject
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end

    -- Initial reference is always the hitbox, not your position.
    lockedHeight = hitbox.Position.Y + HEIGHT_OFFSET

    humanoid.AutoRotate = false
    orbitAngle = 0
    sideInput = 0
    jumping = false
    enabled = true

    createPlatform()

    toggle.Text = "DISABLE FOLLOW"
    toggle.BackgroundColor3 = Color3.fromRGB(170, 60, 60)
    status.Text = "Status: FOLLOWING"

    followConnection = RunService.Heartbeat:Connect(function()
        if not enabled then
            return
        end

        if not root or not root.Parent
            or not humanoid or humanoid.Health <= 0 then
            status.Text = "Status: CHARACTER UNAVAILABLE"
            return
        end

        local currentHitbox = getHitbox()

        if not currentHitbox then
            status.Text = "Status: HITBOX NOT FOUND"
            return
        end

        local orangeModel = getOrangeModel()

        -- Update the locked height only when Orange is grounded.
        -- While he jumps or ragdolls, preserve the last standing height.
        if orangeModel and isOrangeStanding(orangeModel) then
            lockedHeight = currentHitbox.Position.Y + HEIGHT_OFFSET
        end

        orbitAngle = orbitAngle + sideInput * ORBIT_SPEED * (1 / 60)

        local center = currentHitbox.Position

        local hitboxRadius = math.max(
            currentHitbox.Size.X,
            currentHitbox.Size.Z
        ) * 0.5

        local playerRadius = math.max(
            root.Size.X,
            root.Size.Z
        ) * 0.5

        local radius = hitboxRadius + playerRadius + gap

        local offset = Vector3.new(
            math.sin(orbitAngle) * radius,
            0,
            math.cos(orbitAngle) * radius
        )

        local targetY = lockedHeight

        -- Hold the jump position for the full duration,
        -- then snap straight back to the normal height.
        if jumping then
            if os.clock() >= jumpEndsAt then
                jumping = false
            else
                targetY = lockedHeight + JUMP_HEIGHT
            end
        end

        local targetPosition = Vector3.new(
            center.X + offset.X,
            targetY,
            center.Z + offset.Z
        )

        root.CFrame = CFrame.new(targetPosition) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero

        -- Keep platform directly beneath the character.
        local footY = root.Position.Y
            - humanoid.HipHeight
            - root.Size.Y * 0.5

        if platform and platform.Parent then
            platform.Position = Vector3.new(
                root.Position.X,
                footY - PLATFORM_SIZE.Y * 0.5 + 0.05,
                root.Position.Z
            )
        end

        status.Text = "Status: FOLLOWING | GAP " .. gap
    end)
end

--========================================================
-- KEYBOARD
--========================================================

track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not enabled then
        return
    end

    if input.KeyCode == Enum.KeyCode.A
        or input.KeyCode == Enum.KeyCode.Left then
        sideInput = 1

    elseif input.KeyCode == Enum.KeyCode.D
        or input.KeyCode == Enum.KeyCode.Right then
        sideInput = -1

    elseif input.KeyCode == Enum.KeyCode.Space then
        if not jumping and lockedHeight and root and root.Parent then
            jumping = true
            jumpEndsAt = os.clock() + JUMP_DURATION
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.A
        or input.KeyCode == Enum.KeyCode.Left
        or input.KeyCode == Enum.KeyCode.D
        or input.KeyCode == Enum.KeyCode.Right then
        sideInput = 0
    end
end))

--========================================================
-- GUI BUTTONS
--========================================================

track(toggle.Activated:Connect(function()
    if enabled then
        stopFollowing()
    else
        startFollowing()
    end
end))

track(minimize.Activated:Connect(function()
    main.Visible = false
    reopen.Visible = true
end))

track(reopen.Activated:Connect(function()
    main.Visible = true
    reopen.Visible = false
end))

track(close.Activated:Connect(function()
    if closed then
        return
    end

    stopFollowing()
    closed = true

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    table.clear(connections)

    if gui and gui.Parent then
        gui:Destroy()
    end
end))

