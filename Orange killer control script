local MIN_GAP = 2
local MAX_GAP = 40

local HEIGHT_OFFSET = -4
local JUMP_HEIGHT = 17
local JUMP_DURATION = 0.8
local ORBIT_SPEED = 1.8

local PLATFORM_SIZE = Vector3.new(7, 0.35, 7)
