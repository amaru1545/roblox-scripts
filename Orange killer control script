--========================================================
-- FIND ORANGE KILLER
--========================================================

local function getOrangeModel()
    return workspace:FindFirstChild(MODEL_NAME, true)
end

local function getHitbox()
    local model = getOrangeModel()

    if not model then
        return nil
    end

    local hitbox = model:FindFirstChild(HITBOX_NAME, true)

    if hitbox and hitbox:IsA("BasePart") then
        return hitbox
    end

    return nil
end

--========================================================
-- DETECT WHEN ORANGE IS GROUNDED
--========================================================

local function isOrangeStanding(model)
    if not model then
        return false
    end

    local orangeHumanoid =
        model:FindFirstChildWhichIsA("Humanoid", true)

    if orangeHumanoid then
        local state = orangeHumanoid:GetState()

        return orangeHumanoid.Health > 0
            and orangeHumanoid.FloorMaterial ~= Enum.Material.Air
            and state ~= Enum.HumanoidStateType.Jumping
            and state ~= Enum.HumanoidStateType.Freefall
            and state ~= Enum.HumanoidStateType.FallingDown
            and state ~= Enum.HumanoidStateType.Ragdoll
    end

    -- Fallback for models without a Humanoid:
    -- treat the hitbox as standing when its vertical velocity
    -- stays near zero. This is only an approximation.
    return false
end

