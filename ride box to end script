local function cleanup()
    if not alive then
        return
    end

    alive = false

    formationEnabled = false
    pointBringerEnabled = false

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    removeAllTrails()
    restoreAll()

    if gui.Parent then
        gui:Destroy()
    end

    if effectsGui.Parent then
        effectsGui:Destroy()
    end
end

