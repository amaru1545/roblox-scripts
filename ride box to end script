local function distanceToGui(mousePosition)
    if not main.Visible then
        return math.huge
    end

    local pos = main.AbsolutePosition
    local size = main.AbsoluteSize

    local nearestX = math.clamp(
        mousePosition.X,
        pos.X,
        pos.X + size.X
    )

    local nearestY = math.clamp(
        mousePosition.Y,
        pos.Y,
        pos.Y + size.Y
    )

    return (
        mousePosition - Vector2.new(nearestX, nearestY)
    ).Magnitude
end

local function updateSymbolCircle(dt)
    symbolClock += dt

    local mousePosition = UserInputService:GetMouseLocation()
    local distance = distanceToGui(mousePosition)

    local targetGlow = math.clamp(
        1 - distance / SYMBOL_GLOW_DISTANCE,
        0,
        1
    )

    currentGlow += (targetGlow - currentGlow)
        * math.clamp(dt * 3.5, 0, 1)

    for i, label in ipairs(symbolLabels) do
        -- Every symbol gets its own angle around the full circle.
        local angle = (i - 1) / SYMBOL_COUNT * math.pi * 2
            + symbolClock * 0.8

        local radius = SYMBOL_RADIUS
            + math.sin(symbolClock * 1.5 + i) * 3

        label.Position = UDim2.fromOffset(
            mousePosition.X + math.cos(angle) * radius,
            mousePosition.Y + math.sin(angle) * radius
        )

        local glow = math.clamp(
            currentGlow * (
                0.78 + 0.22 * math.sin(symbolClock * 2 + i)
            ),
            0,
            1
        )

        label.TextTransparency = 1 - glow * 0.85
        label.TextSize = 13 + math.floor(glow * 5)
        label.Rotation = math.deg(angle) % 360

        label.Text = SYMBOLS[
            (math.floor(symbolClock * 2 + i) - 1)
                % #SYMBOLS + 1
        ]
    end
end

