--==================================================
-- BRING FLY PATHS
--==================================================

local function refreshFormationParts()
    local found = getNamedParts(FORMATION_PART_NAME)
    local newList = {}

    for _, part in ipairs(found) do
        if part.Parent then
            newList[#newList + 1] = part

            rememberPart(part)

            pcall(function()
                part.CanCollide = false
            end)

            createTrail(part)
        end
    end

    for _, part in ipairs(formationParts) do
        if not table.find(newList, part) then
            removeTrail(part)
            restorePart(part)
        end
    end

    formationParts = newList
end

local function formationTarget(index, total, t)
    if not humanoidRootPart then
        return nil
    end

    local root = humanoidRootPart

    local angle = t * FORMATION_SPEED
        + (index / math.max(total, 1)) * math.pi * 2

    local radius = FORMATION_RADIUS
        + math.sin(t * 1.7 + index) * 1.1

    local orbit = Vector3.new(
        math.cos(angle) * radius,
        FORMATION_HEIGHT + math.sin(t * 2 + index * 0.7) * 1.3,
        math.sin(angle) * radius
    )

    local side = (index - 1) % 3
    local row = math.floor((index - 1) / 3)

    local rowOffset = Vector3.new(
        (side - 1) * 1.5,
        -row * 0.8,
        0
    )

    local worldOffset = root.CFrame:VectorToWorldSpace(
        orbit + rowOffset
    )

    local position = root.Position + worldOffset

    local swoop = (math.sin(t * 2.1 + index * 1.4) + 1) / 2

    local nearOffset = root.CFrame:VectorToWorldSpace(Vector3.new(
        math.cos(angle) * 0.7,
        0.2 + math.sin(t * 3 + index) * 0.5,
        math.sin(angle) * 0.7
    ))

    position = position:Lerp(
        root.Position + nearOffset,
        swoop * 0.82
    )

    local minimumHeight = root.Position.Y - 1.2

    position = Vector3.new(
        position.X,
        math.max(position.Y, minimumHeight),
        position.Z
    )

    return CFrame.lookAt(
        position,
        root.Position + root.CFrame.LookVector * 2
    )
end

--==================================================
-- POINT BRINGER
--==================================================

local function refreshPoints()
    local found = getNamedParts(POINT_PART_NAME)
    local limited = {}

    for i = 1, math.min(#found, MAX_POINTS_PER_SCAN) do
        local part = found[i]
        limited[#limited + 1] = part
        rememberPart(part)
    end

    for _, part in ipairs(pointParts) do
        if not table.find(limited, part) then
            restorePart(part)
        end
    end

    pointParts = limited
end

local function pointTarget(index)
    if not humanoidRootPart then
        return nil
    end

    local angle = phase * 2.5 + index * 0.45
    local radius = 2 + (index % 4) * 0.65

    local offset = Vector3.new(
        math.cos(angle) * radius,
        POINT_OFFSET.Y + math.sin(angle * 1.4) * 1.2,
        math.sin(angle) * radius
    )

    return humanoidRootPart.CFrame * CFrame.new(offset)
end

