local function getNamedParts(partName)
    local result = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart")
            and obj.Name == partName
            and not (character and obj:IsDescendantOf(character)) then

            result[#result + 1] = obj
        end
    end

    return result
end

