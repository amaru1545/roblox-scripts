--==================================================
-- PART MOVEMENT LOOP
--==================================================

connections[#connections + 1] =
    RunService.Heartbeat:Connect(function(dt)
        if not alive then
            return
        end

        refreshClock += dt

        if not humanoidRootPart or not humanoidRootPart.Parent then
            updateCharacter()
            return
        end

        if refreshClock >= 1 then
            refreshClock = 0

            if formationEnabled then
                refreshFormationParts()
            end

            if pointBringerEnabled then
                refreshPoints()
            end
        end

        if formationEnabled then
            local total = #formationParts

            for index, part in ipairs(formationParts) do
                if part.Parent then
                    local target = formationTarget(
                        index,
                        total,
                        phase
                    )

                    if target then
                        local alpha = math.clamp(dt * 5.5, 0, 1)

                        pcall(function()
                            part.CFrame = part.CFrame:Lerp(
                                target,
                                alpha
                            )
                        end)
                    end
                end
            end
        end

        if pointBringerEnabled then
            for index, part in ipairs(pointParts) do
                if part.Parent then
                    local target = pointTarget(index)

                    if target then
                        local alpha = math.clamp(
                            dt / POINT_BRING_SPEED,
                            0,
                            1
                        )

                        pcall(function()
                            part.CFrame = part.CFrame:Lerp(
                                target,
                                alpha
                            )

                            part.CanCollide = false
                        end)
                    end
                end
            end
        end
    end)

