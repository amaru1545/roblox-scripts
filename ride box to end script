--==================================================
-- PART STATE
--==================================================

local function rememberPart(part)
    if not part:IsA("BasePart") or originalState[part] then
        return
    end

    originalState[part] = {
        CFrame = part.CFrame,
        Anchored = part.Anchored,
        CanCollide = part.CanCollide,
        CanTouch = part.CanTouch,
        CanQuery = part.CanQuery,
    }
end

local function restorePart(part)
    local state = originalState[part]
    if not state then
        return
    end

    if part.Parent then
        pcall(function()
            part.CFrame = state.CFrame
            part.Anchored = state.Anchored
            part.CanCollide = state.CanCollide
            part.CanTouch = state.CanTouch
            part.CanQuery = state.CanQuery
        end)
    end

    originalState[part] = nil
end

local function restoreAll()
    for part in pairs(originalState) do
        restorePart(part)
    end
end

--==================================================
-- FLYING TRAILS
--==================================================

local function createTrail(part)
    if trails[part] or not part.Parent then
        return
    end

    local a0 = Instance.new("Attachment")
    a0.Name = "TuffTrailA"
    a0.Position = Vector3.new(0, part.Size.Y * 0.35, 0)
    a0.Parent = part

    local a1 = Instance.new("Attachment")
    a1.Name = "TuffTrailB"
    a1.Position = Vector3.new(0, -part.Size.Y * 0.35, 0)
    a1.Parent = part

    local trail = Instance.new("Trail")
    trail.Name = "TuffFlyingTrail"
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = TRAIL_LIFETIME
    trail.MinLength = 0.05
    trail.FaceCamera = true
    trail.LightEmission = 1

    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, CYAN),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 80, 255)),
    })

    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1),
    })

    trail.Parent = part

    trails[part] = {
        trail = trail,
        a0 = a0,
        a1 = a1,
    }
end

local function removeTrail(part)
    local data = trails[part]
    if not data then
        return
    end

    for _, object in pairs(data) do
        if object then
            object:Destroy()
        end
    end

    trails[part] = nil
end

local function removeAllTrails()
    for part in pairs(trails) do
        removeTrail(part)
    end
end

