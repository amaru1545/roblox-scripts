local function onCharacter(char)
	for _, c in ipairs(Janitor) do c:Disconnect() end
	table.clear(Janitor)

	if S.Flying then stopFlight() end
	stopUnibeam()
	if ShieldPart then ShieldPart:Destroy() ShieldPart = nil end
	S.Shield = false
	clearArmor(false)
	S.Suit, S.Deploying, S.Flying, S.Charging, S.Busy, S.Boosting = false, false, false, false, false, false
	S.BoostActive, S.Facing = false, false
	S.Target, S.TargetInfo, S.OverdriveUntil, S.Vel = nil, nil, 0, Vector3.zero
	S.Energy = CFG.MaxEnergy

	bindCharacter(char)
	jconnect(Humanoid.Died, function()
		suitDown("PILOT DOWN // SYSTEMS OFFLINE", true, true)
	end)
	setStatus("SYSTEM STANDBY // NEW PILOT BODY DETECTED")
end

