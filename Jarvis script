--========================================================
-- HUD UPDATE
--========================================================

local function updateHud(dt, cam)
	local eAlpha = S.Energy / CFG.MaxEnergy
	Gui.Energy.Size = UDim2.fromScale(math.clamp(eAlpha, 0, 1), 1)
	Gui.Energy.BackgroundColor3 = eAlpha < 0.2 and C.Warn or (overdriveActive() and C.Gold or C.Cyan)
	Gui.EnergyText.Text = string.format("%d%%", math.floor(eAlpha * 100 + 0.5))

	local hp = math.clamp(Humanoid.Health / math.max(Humanoid.MaxHealth, 1), 0, 1)
	Gui.Integrity.Size = UDim2.fromScale(hp, 1)
	Gui.Integrity.BackgroundColor3 = hp < 0.3 and C.Warn or Color3.fromRGB(90, 255, 140)

	local function cd(name, last, total)
		local a = math.clamp((os.clock() - last) / total, 0, 1)
		Gui.Cooldowns[name].Size = UDim2.fromScale(a, 1)
		Gui.Cooldowns[name].BackgroundColor3 = a >= 1 and C.Cyan or C.Gold
	end
	cd("REP", S.Last.Repulsor, CFG.RepulsorCooldown)
	cd("MSL", S.Last.Missile, CFG.MissileCooldown)
	cd("OVR", S.Last.Overdrive, CFG.OverdriveCooldown)
	cd("STK", S.Last.Strike, CFG.StrikeCooldown)

	local mods = {}
	if S.Shield then table.insert(mods, "SHIELD") end
	if S.Unibeam then table.insert(mods, "UNIBEAM") end
	if overdriveActive() then table.insert(mods, "OVERDRIVE") end
	if S.BoostActive then table.insert(mods, "BOOST") end
	Gui.Modules.Text = #mods > 0 and ("ACTIVE: " .. table.concat(mods, " / ")) or ""

	Gui.Telemetry.Text = string.format("SPD %3d   ALT %4d",
		Root.AssemblyLinearVelocity.Magnitude, Root.Position.Y)

	-- compass
	local look = cam.CFrame.LookVector
	local heading = math.deg(math.atan2(look.X, -look.Z)) % 360
	Gui.Heading.Text = string.format("%03d", heading)
	for _, t in ipairs(Gui.Ticks) do
		local diff = ((t.Deg - heading + 540) % 360) - 180
		if math.abs(diff) < 52 then
			t.Label.Visible = true
			t.Label.Position = UDim2.new(0.5, diff * 4.2, 0, 8)
		else
			t.Label.Visible = false
		end
	end

	-- radar
	Gui.RadarSweep.Rotation = (clock * 140) % 360
	local flatF = Vector3.new(look.X, 0, look.Z)
	if flatF.Magnitude > 0.01 then
		flatF = flatF.Unit
		local flatR = Vector3.new(-flatF.Z, 0, flatF.X)
		local used = 0
		for _, c in ipairs(S.Candidates) do
			if alive(c.Root) and c.Humanoid.Health > 0 and used < #Gui.Blips then
				local rel = c.Root.Position - Root.Position
				local x, y = rel:Dot(flatR), rel:Dot(flatF)
				local dist = math.sqrt(x * x + y * y)
				if dist < 120 then
					used += 1
					local b = Gui.Blips[used]
					b.Visible = true
					b.Position = UDim2.new(0.5, x / 120 * 68, 0.5, -y / 120 * 68)
					b.BackgroundColor3 = (c.Root == S.Target) and C.Gold or C.Warn
				end
			end
		end
		for i = used + 1, #Gui.Blips do Gui.Blips[i].Visible = false end
	end

	-- reticle + ring
	local charging = S.Charging and S.Suit
	local cAlpha = charging and math.clamp((os.clock() - S.ChargeStart) / CFG.ChargeTime, 0, 1) or 0
	local locked = S.Target ~= nil
	for _, p in ipairs(Gui.ReticleParts) do
		p.BackgroundColor3 = locked and C.Warn or C.Cyan
	end
	Gui.Reticle.Rotation = locked and (clock * 90) % 360 or 0
	local ringSize = 56 - cAlpha * 22
	Gui.Ring.Size = UDim2.fromOffset(ringSize, ringSize)
	Gui.RingStroke.Transparency = charging and (0.5 - cAlpha * 0.45) or 0.75
	Gui.RingStroke.Color = cAlpha >= 1 and C.Gold or C.Cyan
	Gui.Charge.Size = UDim2.fromScale(cAlpha, 1)

	-- target brackets
	local info = S.TargetInfo
	if info and alive(info.Root) and S.HUD then
		local v, onScreen = cam:WorldToViewportPoint(info.Root.Position)
		if onScreen and v.Z > 0 then
			local dist = (info.Root.Position - cam.CFrame.Position).Magnitude
			local size = math.clamp(7000 / dist, 54, 160)
			Gui.Brackets.Visible = true
			Gui.Brackets.Position = UDim2.fromOffset(v.X, v.Y)
			Gui.Brackets.Size = UDim2.fromOffset(size, size)
			Gui.Brackets.Rotation = math.sin(clock * 3) * 4
			local h = info.Humanoid
			Gui.BracketText.Text = string.format("%s\n%dm  HP %d%%", info.Name, dist,
				math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1) * 100)
		else
			Gui.Brackets.Visible = false
		end
	else
		Gui.Brackets.Visible = false
	end

	-- speed lines
	local intensity = 0
	if S.Flying then
		intensity = math.clamp((S.Vel.Magnitude - CFG.FlightSpeed * 0.6) / (CFG.BoostSpeed - CFG.FlightSpeed * 0.6), 0, 1)
	end
	local vp = cam.ViewportSize
	local maxR = math.max(vp.X, vp.Y) * 0.65
	for _, l in ipairs(Gui.SpeedLines) do
		if intensity < 0.05 then
			l.Frame.BackgroundTransparency = 1
		else
			l.Phase = (l.Phase + dt * (0.6 + intensity * 1.6)) % 1
			local r = maxR * (0.35 + l.Phase * 0.75)
			local dirx, diry = math.cos(l.Angle), math.sin(l.Angle)
			l.Frame.Position = UDim2.new(0.5, dirx * r, 0.5, diry * r)
			l.Frame.Rotation = math.deg(l.Angle) + 90
			l.Frame.Size = UDim2.fromOffset(2, 40 + intensity * 150)
			l.Frame.BackgroundTransparency = 1 - intensity * 0.55 * (1 - math.abs(l.Phase - 0.5) * 1.4)
		end
	end
end

--========================================================
-- MAIN LOOP
--========================================================

connect(RunService.RenderStepped, function(dt)
	clock += dt
	local cam = workspace.CurrentCamera
	if not cam or not Character or not Character.Parent or not Humanoid or not Root then return end

	if S.StatusText ~= "" and os.clock() - S.StatusTime > 2.5 and Gui.Status then
		Gui.Status.Text = baseStatus()
	end

	stepDebris(dt)
	stepDeploy()

	-- energy
	if S.Shield then
		S.Energy -= CFG.ShieldDrain * (overdriveActive() and 0.4 or 1) * dt
		if S.Energy <= 0 then
			S.Energy = 0
			setShield(false)
		end
	end
	if not S.Flying and not S.Unibeam and not S.Shield then
		local mult = (S.Suit and overdriveActive()) and 2.5 or 1
		S.Energy = math.min(CFG.MaxEnergy, S.Energy + CFG.Regen * mult * dt)
	end
	S.Energy = math.clamp(S.Energy, 0, CFG.MaxEnergy)

	updateHud(dt, cam)

	local charging = S.Charging and S.Suit
	local cAlpha = charging and math.clamp((os.clock() - S.ChargeStart) / CFG.ChargeTime, 0, 1) or 0
	if ChargeOrb then
		ChargeOrb.Transparency = charging and 0.1 or 1
		ChargeOrb.Size = Vector3.one * (0.3 + cAlpha * 1.4)
		ChargeOrb.Color = cAlpha >= 1 and C.Gold or C.Cyan
	end
	if ChargeLight then
		ChargeLight.Brightness = charging and (3 + cAlpha * 8) or 0
		ChargeLight.Color = cAlpha >= 1 and C.Gold or C.Cyan
	end
	if PalmEmitter then PalmEmitter.Enabled = charging end
	S.LoopTarget.Charge = charging and (0.25 + cAlpha * 0.35) or 0
	if Loops.Charge then Loops.Charge.PlaybackSpeed = 0.6 + cAlpha * 1.8 end
	if charging and cAlpha >= 1 and not S.FullChargeNotified then
		S.FullChargeNotified = true
		setStatus("REPULSOR AT FULL CHARGE")
		playSound(SND.Ping, { Volume = 0.7, Speed = 2.4 })
		addShake(0.08)
	elseif not charging then
		S.FullChargeNotified = false
	end

	local targetFov = CFG.BaseFOV

	if S.Suit then
		if Reactor and ReactorLight then
			local over = overdriveActive()
			local pulse = 3 + math.sin(clock * (over and 9 or 4)) * 0.8
			if not S.Busy then
				ReactorLight.Brightness = (over and (pulse + 5) or pulse) + (S.Unibeam and 6 or 0)
				ReactorLight.Range = over and 28 or 16
			end
			local col = (over or S.Unibeam or (charging and cAlpha >= 1)) and C.Gold or C.Cyan
			Reactor.Color = col
			ReactorLight.Color = col
		end
		if SuitHighlight then
			SuitHighlight.OutlineTransparency = 0.12 + math.sin(clock * 3) * 0.06
			SuitHighlight.OutlineColor = overdriveActive() and C.Cyan or C.Gold
		end
		if ShieldPart then
			ShieldPart.Transparency = 0.5 + math.sin(clock * 5) * 0.12
		end
		S.LoopTarget.Hum = S.Deploying and 0 or (0.07 + (overdriveActive() and 0.1 or 0))
		if Loops.Hum then Loops.Hum.PlaybackSpeed = overdriveActive() and 0.45 or 0.3 end

		local eAlpha = S.Energy / CFG.MaxEnergy
		if eAlpha < 0.2 and os.clock() - S.LastLowWarn > 1.6 then
			S.LastLowWarn = os.clock()
			playSound(SND.Ping, { Volume = 0.35, Speed = 0.9 })
		end

		if S.Unibeam then updateUnibeam(dt) end

		if S.Flying and FlightVelocity and FlightOrientation then
			updateFlight(dt)
			targetFov = CFG.BaseFOV + (CFG.BoostFOV - CFG.BaseFOV)
				* (S.BoostActive and 1 or math.clamp(S.Vel.Magnitude / CFG.BoostSpeed * 0.3, 0, 0.3))
		end

		-- face the reticle while aiming on the ground
		local aiming = charging or S.Unibeam or os.clock() < S.AimUntil
		if not S.Flying then
			if aiming then
				if not S.Facing then
					S.Facing = true
					Humanoid.AutoRotate = false
				end
				local look = cam.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude > 0.01 then
					local goal = CFrame.lookAt(Root.Position, Root.Position + flat)
					Root.CFrame = Root.CFrame:Lerp(goal, math.clamp(dt * 14, 0, 1))
				end
			elseif S.Facing then
				S.Facing = false
				Humanoid.AutoRotate = true
			end
		end

		-- arm poses
		if not S.Deploying then
			local pitch = math.deg(math.asin(math.clamp(cam.CFrame.LookVector.Y, -1, 1)))
			local left, right = 0, 0
			if S.Flying then
				local base = 15 + 155 * S.SpeedAlpha
				left, right = base, base
			end
			if S.Shield and not S.Flying then left = 18 right = 18 end
			if aiming and not S.Unibeam then
				right = 90 + pitch + (S.Flying and S.LeanDeg or 0)
			end
			applyPose(dt, left, right)
		end

		if os.clock() - S.LastScan > 0.1 then
			S.LastScan = os.clock()
			scanTarget()
		end
	end

	updateLoops(dt)

	-- camera: FOV (with decaying punch) and shake
	S.FovKick = S.FovKick * math.max(0, 1 - dt * 5)
	cam.FieldOfView += ((targetFov + S.FovKick) - cam.FieldOfView) * math.clamp(dt * 7, 0, 1)

	if S.Shake > 0.002 then
		Humanoid.CameraOffset = Vector3.new(
			(math.random() - 0.5) * S.Shake, (math.random() - 0.5) * S.Shake, 0)
		S.Shake = S.Shake * math.max(0, 1 - dt * 7)
	elseif Humanoid.CameraOffset ~= Vector3.zero then
		Humanoid.CameraOffset = Vector3.zero
		S.Shake = 0
	end
end)

