local function bootLog(lines)
	S.BootToken += 1
	local token = S.BootToken
	Gui.Log.Text = ""
	Gui.Log.TextTransparency = 0
	task.spawn(function()
		local text = ""
		for _, line in ipairs(lines) do
			for i = 1, #line do
				if token ~= S.BootToken then return end
				text ..= line:sub(i, i)
				Gui.Log.Text = text
				if i % 3 == 0 then
					playSound(SND.Click, { Volume = 0.1, Speed = 2.2 + math.random() * 0.4 })
				end
				task.wait(0.012)
			end
			text ..= "\n"
			task.wait(0.08)
		end
		task.wait(3.5)
		if token == S.BootToken then tween(Gui.Log, 1, { TextTransparency = 1 }) end
	end)
end

