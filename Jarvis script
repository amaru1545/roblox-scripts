local function setupShoulders()
	table.clear(Shoulders)
	local r15 = isR15()
	local holder = r15 and Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Torso")
	if not holder then return end
	for _, side in ipairs({ "Left", "Right" }) do
		local m = holder:FindFirstChild(r15 and (side .. "Shoulder") or (side .. " Shoulder"))
		if m and m:IsA("Motor6D") then
			Shoulders[side] = { Motor = m, Orig = m.C0, Angle = 0 }
		end
	end
end

local function restorePose()
	for _, s in pairs(Shoulders) do
		if alive(s.Motor) then s.Motor.C0 = s.Orig end
	end
	table.clear(Shoulders)
end

local function applyPose(dt, left, right)
	local r15 = isR15()
	local targets = { Left = left, Right = right }
	for side, s in pairs(Shoulders) do
		if alive(s.Motor) then
			local t = math.rad(targets[side] or 0)
			s.Angle += (t - s.Angle) * math.clamp(dt * 12, 0, 1)
			if r15 then
				s.Motor.C0 = s.Orig * CFrame.Angles(s.Angle, 0, 0)
			else
				local sign = side == "Right" and 1 or -1
				s.Motor.C0 = s.Orig * CFrame.Angles(0, 0, s.Angle * sign)
			end
		end
	end
end

