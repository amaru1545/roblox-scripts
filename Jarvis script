--========================================================

local function launchMissile(origin, targetPart, fixedPoint, delay, spread)
	task.delay(delay, function()
		if not S.Suit or not Root then return end

		local missile = make("Part", {
			Name = "Missile", Size = Vector3.new(0.35, 0.35, 1.4),
			CFrame = CFrame.new(origin),
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			CastShadow = false, Material = Enum.Material.Neon, Color = C.Gold,
		}, VFX)
		make("PointLight", { Color = C.Gold, Brightness = 4, Range = 8 }, missile)
		local a0 = make("Attachment", { Position = Vector3.new(0, 0.15, 0.6) }, missile)
		local a1 = make("Attachment", { Position = Vector3.new(0, -0.15, 0.6) }, missile)
		make("Trail", {
			Attachment0 = a0, Attachment1 = a1, Lifetime = 0.5,
			Color = ColorSequence.new(C.Gold, C.Cyan), LightEmission = 1,
			Transparency = NumberSequence.new(0, 1),
			WidthScale = NumberSequence.new(1, 0),
		}, missile)
		local s0 = make("Attachment", { Position = Vector3.new(0, 0.35, 0.6) }, missile)
		local s1 = make("Attachment", { Position = Vector3.new(0, -0.35, 0.6) }, missile)
		make("Trail", {
			Attachment0 = s0, Attachment1 = s1, Lifetime = 1.1,
			Color = ColorSequence.new(Color3.fromRGB(200, 200, 205)),
			Transparency = NumberSequence.new(0.5, 1),
			WidthScale = NumberSequence.new(1, 3),
		}, missile)

		playSound(SND.Shot, { Parent = missile, Volume = 0.45, Speed = 1.1 + math.random() * 0.3 })

		local control = origin + Vector3.new(0, 14 + math.random() * 12, 0) + spread * 16
		local startTime = os.clock()
		local dest = (alive(targetPart) and targetPart.Position) or fixedPoint
		local duration = math.clamp((dest - origin).Magnitude / CFG.MissileSpeed, 0.5, 1.9)
		local conn

		conn = RunService.RenderStepped:Connect(function()
			if not alive(missile) then conn:Disconnect() return end
			if alive(targetPart) then dest = targetPart.Position end

			local t = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local function bez(x)
				local u = 1 - x
				return u * u * origin + 2 * u * x * control + x * x * dest
			end
			local pos, nextPos = bez(t), bez(math.min(t + 0.02, 1))
			if (nextPos - pos).Magnitude > 0.001 then
				missile.CFrame = CFrame.lookAt(pos, nextPos)
			else
				missile.CFrame = CFrame.new(pos)
			end

			if t >= 1 then
				conn:Disconnect()
				local ground = workspace:Raycast(dest + Vector3.new(0, 3, 0), Vector3.new(0, -8, 0), rayParams())
				impactAt(dest, ground and ground.Normal or Vector3.yAxis, C.Gold, 1.1,
					ground and ground.Instance)
				missile:Destroy()
			end
		end)
		Debris:AddItem(missile, 4)
	end)
end

function fireMissiles()
	if not systemsReady() or S.Busy then return end
	if os.clock() - S.Last.Missile < CFG.MissileCooldown then
		setStatus("MISSILES RELOADING")
		playSound(SND.Click, { Volume = 0.6, Speed = 0.5 })
		return
	end
	if not spend(CFG.MissileCost) then return end
	S.Last.Missile = os.clock()
	S.AimUntil = os.clock() + CFG.AimHold

	local cam = workspace.CurrentCamera
	local targets = evaluateTargets(CFG.MultiLockCone, 4)
	local point = aimPoint(250)
	local upper = bodyPart("UpperTorso", "Torso")
	local base = upper and upper.CFrame or Root.CFrame

	for i = 1, CFG.MissileCount do
		local side = (i % 2 == 0) and 1 or -1
		local origin = base:PointToWorldSpace(Vector3.new(side * 1.3, 1.1, 0.6))
		local spread = (cam.CFrame.RightVector * side + Vector3.new(0, 0.6, 0)).Unit
		local t = targets[((i - 1) % math.max(#targets, 1)) + 1]
		local scatter = Vector3.new(rnd(-7, 7), rnd(-4, 4), rnd(-7, 7))
		launchMissile(origin, t and t.Root or nil, point + scatter, (i - 1) * 0.08, spread)
	end

	playSound(SND.Click, { Volume = 0.6, Speed = 1.6 })
	addShake(0.25)
	setStatus(#targets > 0 and string.format("BARRAGE // %d TARGETS LOCKED", #targets) or "MISSILE BARRAGE // UNGUIDED")
end

