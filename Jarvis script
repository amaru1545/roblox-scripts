local METAL = Enum.Material.Metal

local function piece(name, body, size, offset, color, material, shape, opts)
	if not body then return nil end
	opts = opts or {}
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or METAL
	part.Reflectance = (material == Enum.Material.Neon) and 0 or 0.12
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Massless = true
	part.Transparency = 1
	if shape then part.Shape = shape end

	local final = body.CFrame * offset
	local away = Vector3.new(rnd(-1, 1), rnd(-0.2, 1), rnd(-1, 1))
	if away.Magnitude < 0.1 then away = Vector3.yAxis end
	local start = CFrame.new(final.Position + away.Unit * rnd(16, 34))
		* CFrame.Angles(rnd(0, 6.28), rnd(0, 6.28), rnd(0, 6.28))
	part.CFrame = start
	part.Parent = VFX
	part:SetAttribute("T", opts.T or 0)
	if opts.Head then part:SetAttribute("HeadGear", true) end

	table.insert(Pieces, {
		Part = part, Body = body, Offset = offset, Start = start,
		Delay = (#Pieces) * 0.03 + math.random() * 0.15,
		Dur = rnd(0.5, 0.8), Done = false, Final = opts.T or 0,
	})
	return part
end

