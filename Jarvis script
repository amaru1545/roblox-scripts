-- flat disc facing "normal"
local function disc(position, normal, radius, thickness, color, transparency, material)
	normal = normal or Vector3.yAxis
	local cf
	if math.abs(normal:Dot(Vector3.yAxis)) > 0.999 then
		cf = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	else
		cf = CFrame.lookAt(position, position + normal) * CFrame.Angles(0, math.pi / 2, 0)
	end
	return make("Part", {
		Name = "Disc", Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2), CFrame = cf,
		Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		CastShadow = false, Material = material or Enum.Material.Neon,
		Color = color, Transparency = transparency or 0,
	}, VFX)
end

local function shockwave(position, color, radius, duration, thickness, normal)
	local ring = disc(position, normal, 1, thickness or 0.3, color, 0.1)
	tween(ring, duration, {
		Size = Vector3.new(thickness or 0.3, radius * 2, radius * 2),
		Transparency = 1,
	})
	Debris:AddItem(ring, duration + 0.15)
end

-- ballistic debris (no physics engine, no pushing the player)
local DebrisList = {}

local function spawnDebris(position, color, count, speed)
	for _ = 1, count do
		local s = rnd(0.15, 0.5)
		local p = make("Part", {
			Size = Vector3.new(s, s * rnd(0.5, 1.4), s),
			CFrame = CFrame.new(position) * CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6)),
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			CastShadow = false, Material = Enum.Material.Slate, Color = color,
		}, VFX)
		local v = Vector3.new(rnd(-1, 1), rnd(0.5, 1.6), rnd(-1, 1))
		table.insert(DebrisList, {
			Part = p, Vel = v.Unit * speed * rnd(0.4, 1.1),
			Spin = Vector3.new(rnd(-9, 9), rnd(-9, 9), rnd(-9, 9)),
			Life = rnd(0.8, 1.5), Age = 0,
		})
	end
end

local function stepDebris(dt)
	for i = #DebrisList, 1, -1 do
		local d = DebrisList[i]
		d.Age += dt
		if d.Age >= d.Life or not alive(d.Part) then
			if alive(d.Part) then d.Part:Destroy() end
			table.remove(DebrisList, i)
		else
			d.Vel += Vector3.new(0, -70 * dt, 0)
			d.Part.CFrame = d.Part.CFrame * CFrame.Angles(d.Spin.X * dt, d.Spin.Y * dt, d.Spin.Z * dt) + d.Vel * dt
			d.Part.Transparency = math.clamp((d.Age / d.Life - 0.6) * 2.5, 0, 1)
		end
	end
end

local function explosion(position, color, scale, silent)
	glowBall(position, 3 * scale, color, 0.35)
	glowBall(position, 8 * scale, C.White, 0.5)
	glowBall(position, 15 * scale, color, 0.8)
	particlesAt(position, color, math.floor(60 * scale), 35 * scale)
	shockwave(position, color, 10 * scale, 0.5, 0.2)

	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		local dir = Vector3.new(math.cos(a), rnd(0.1, 0.6), math.sin(a))
		lightning(position, position + dir * 12 * scale, color, 0.18 * scale, 0.4, 4, 2.5 * scale)
	end

	if not silent then
		playSound(SND.Boom, {
			Position = position, Volume = math.clamp(0.35 * scale, 0.2, 1),
			Speed = math.clamp(1.3 - scale * 0.25, 0.5, 1.3) + math.random() * 0.1,
			Range = 280, Reverb = scale > 1,
		})
	end

	if Root then
		local dist = (Root.Position - position).Magnitude
		addShake(math.clamp(scale * 0.35 * (1 - dist / 140), 0, 0.7))
	end
end

-- impact on a surface: blast, scorch mark, debris, dust
local function impactAt(position, normal, color, scale, hitInstance, silent)
	normal = normal or Vector3.yAxis
	explosion(position, color, scale, silent)
	shockwave(position + normal * 0.1, color, 7 * scale, 0.45, 0.15, normal)

	local scorch = disc(position + normal * 0.06, normal, 1.6 * scale, 0.05,
		Color3.fromRGB(18, 18, 20), 0.15, Enum.Material.SmoothPlastic)
	scorch.CastShadow = false
	task.delay(2.5, function()
		if alive(scorch) then tween(scorch, 1.5, { Transparency = 1 }) end
	end)
	Debris:AddItem(scorch, 4.2)

	local col = Color3.fromRGB(120, 110, 100)
	if hitInstance and hitInstance:IsA("BasePart") then
		col = hitInstance.Color:Lerp(Color3.fromRGB(110, 105, 100), 0.4)
	end
	spawnDebris(position + normal * 0.3, col, math.floor(10 * scale + 4), 26 * scale + 8)
	dustAt(position + normal * 0.4, col:Lerp(Color3.new(1, 1, 1), 0.35), math.floor(6 * scale + 2), 10 * scale + 4)
end

local function screenFlash(color, strength, duration)
	local cc = make("ColorCorrectionEffect", {
		TintColor = color, Brightness = strength, Saturation = 0.2,
	}, Lighting)
	local t = tween(cc, duration, { Brightness = 0, TintColor = Color3.new(1, 1, 1), Saturation = 0 })
	t.Completed:Connect(function() cc:Destroy() end)
	Debris:AddItem(cc, duration + 0.5)
end

