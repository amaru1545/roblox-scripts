		Color = ColorSequence.new(color, C.White), LightEmission = 1,
		Transparency = NumberSequence.new(0.2, 1),
		WidthScale = NumberSequence.new(1, 0),
	}, body)
	table.insert(Thrusters, { Emitter = em, Trail = trail, Attachments = { att, ta, tb } })
