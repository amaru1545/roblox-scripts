function startCharge()
	if not systemsReady() or S.Charging or S.Busy then return end
	if os.clock() - S.Last.Repulsor < CFG.RepulsorCooldown then return end
	S.Charging = true
	S.ChargeStart = os.clock()
	setStatus("REPULSOR CHARGING...")
end

function fireRepulsor()
	if not S.Suit or not S.Charging then return end
	S.Charging = false
	S.AimUntil = os.clock() + CFG.AimHold

	local alpha = math.clamp((os.clock() - S.ChargeStart) / CFG.ChargeTime, 0.15, 1)
	if not spend(CFG.RepulsorCost + 10 * alpha) then return end
	S.Last.Repulsor = os.clock()

	local hand = bodyPart("RightHand", "Right Arm")
	local origin = hand and hand.CFrame:PointToWorldSpace(Vector3.new(0, -hand.Size.Y * 0.5 - 0.3, 0))
		or (Root.Position + Vector3.new(0, 1, 0))

	local destination, hit = aimPoint(200 + 260 * alpha)
	local color = alpha >= 0.9 and C.Gold or C.Cyan
	local dir = (destination - origin)
	if dir.Magnitude < 1 then dir = Root.CFrame.LookVector end
	dir = dir.Unit

	-- layered beam, arcs, muzzle flash
	beamBetween(origin, destination, color, 0.3 + alpha * 0.9, 0.25)
	beamBetween(origin, destination, C.White, 0.1 + alpha * 0.3, 0.18)
	for _ = 1, 2 + math.floor(alpha * 3) do
		lightning(origin, destination, color, 0.08 + alpha * 0.12, 0.2, 10, 1.5 + alpha * 3)
	end
	glowBall(origin, 1.5 + alpha * 2, C.White, 0.2)
	shockwave(origin + dir * 0.5, color, 3 + alpha * 3, 0.3, 0.12, dir)
	impactAt(destination, hit and hit.Normal or Vector3.yAxis, color, 0.5 + alpha * 0.9,
		hit and hit.Instance)
	addShake(0.15 + alpha * 0.35)

	playSound(SND.Shot, { Volume = 0.7, Speed = 2 - alpha * 0.7 })
	playSound(SND.Lunge, { Volume = 0.5, Speed = 1.4 - alpha * 0.5 })
	playSound(SND.Ping, { Volume = 0.5, Speed = 0.5 + alpha * 0.3 })

	if hand then
		local light = make("PointLight", { Color = color, Brightness = 8, Range = 16 }, hand)
		Debris:AddItem(light, 0.18)
	end
	if S.Flying then
		S.Vel -= workspace.CurrentCamera.CFrame.LookVector * (8 + alpha * 18)
	end
	S.FovKick = 5 + alpha * 6
	setStatus(alpha >= 0.9 and "FULL-POWER REPULSOR DISCHARGED" or "REPULSOR DISCHARGED")
end

