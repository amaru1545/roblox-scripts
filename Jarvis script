-- TARGETING
--========================================================

local function addCandidate(model)
	if model == Character then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if hum and root then
		table.insert(S.Candidates, { Model = model, Humanoid = hum, Root = root })
	end
end

local function refreshCandidates()
	table.clear(S.Candidates)
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= Player and pl.Character then addCandidate(pl.Character) end
	end
	for _, inst in ipairs(CollectionService:GetTagged(CFG.TargetTag)) do
		if inst:IsA("Model") then addCandidate(inst) end
	end
	if CFG.ScanNPCs then
		for _, inst in ipairs(workspace:GetDescendants()) do
			if inst:IsA("Humanoid") and inst.Parent:IsA("Model")
				and not Players:GetPlayerFromCharacter(inst.Parent)
				and inst.Parent ~= Character then
				addCandidate(inst.Parent)
			end
		end
	end
end

-- sorted list of visible targets inside a view cone
local function evaluateTargets(cone, maxCount)
	local cam = workspace.CurrentCamera
	local list = {}
	if not cam then return list end
	local params = rayParams()
	for _, c in ipairs(S.Candidates) do
		if alive(c.Root) and c.Humanoid.Health > 0 then
			local rel = c.Root.Position - cam.CFrame.Position
			local dist = rel.Magnitude
			if dist > 5 and dist < CFG.LockRange then
				local dot = cam.CFrame.LookVector:Dot(rel.Unit)
				if dot > cone then
					local hit = workspace:Raycast(cam.CFrame.Position, rel, params)
					if not hit or hit.Instance:IsDescendantOf(c.Model) then
						table.insert(list, { Root = c.Root, Humanoid = c.Humanoid, Name = c.Model.Name,
							Dist = dist, Score = dist * (1 - dot) })
					end
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.Score < b.Score end)
	while #list > maxCount do table.remove(list) end
	return list
end

local function scanTarget()
	if os.clock() - S.LastCandidateRefresh > 2 then
		S.LastCandidateRefresh = os.clock()
		refreshCandidates()
	end
	local list = evaluateTargets(CFG.LockCone, 1)
	local best = list[1]
	if best and not S.Target then
		playSound(SND.Ping, { Volume = 0.4, Speed = 2.2 })
	end
	S.Target = best and best.Root or nil
	S.TargetInfo = best
	Gui.Target.Text = best and ("TARGET: " .. best.Name) or "TARGET: NONE"
end

-- third-person safe aim ray (skips the stretch behind the character)
local function aimPoint(range)
	local cam = workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local skip = math.max(0, (Root.Position - cam.CFrame.Position):Dot(look))
	local start = cam.CFrame.Position + look * skip
	local result = workspace:Raycast(start, look * range, rayParams())
	if result then return result.Position, result end
	return start + look * range, nil
end

