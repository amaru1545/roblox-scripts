	if os.clock() - S.Last.Strike < CFG.StrikeCooldown then
		setStatus("ORBITAL STRIKE RECHARGING")
		playSound(SND.Click, { Volume = 0.6, Speed = 0.5 })
		return
	end

	local pos = aimPoint(450)
	if alive(S.Target) then pos = S.Target.Position end
	local g = workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -240, 0), rayParams())
	local normal = Vector3.yAxis
	if g then pos, normal = g.Position, g.Normal end

	if not spend(CFG.StrikeCost) then return end
	S.Last.Strike = os.clock()
	S.AimUntil = os.clock() + 1
	setStatus("ORBITAL STRIKE // TARGET PAINTED")

	task.spawn(function()
		local outer = disc(pos + normal * 0.15, normal, 28, 0.1, C.Warn, 0.6)
		local inner = disc(pos + normal * 0.2, normal, 9, 0.1, C.Warn, 0.4)
		tween(outer, 1.4, { Size = Vector3.new(0.1, 18, 18) }, Enum.EasingStyle.Linear)
		for _, t in ipairs({ 0, 0.35, 0.65, 0.9, 1.08, 1.22, 1.32 }) do
			task.delay(t, function()
				playSound(SND.Ping, { Position = pos, Volume = 0.7, Speed = 1.8, Range = 300 })
				if alive(inner) then
					inner.Transparency = 0.1
					tween(inner, 0.15, { Transparency = 0.5 })
				end
			end)
		end
		task.wait(1.4)
		if alive(outer) then outer:Destroy() end
		if alive(inner) then inner:Destroy() end

		-- the beam from orbit
		local beam = make("Part", {
			Name = "StrikeBeam", Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(500, 8, 8),
			CFrame = CFrame.new(pos + Vector3.new(0, 250, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			CastShadow = false, Material = Enum.Material.Neon, Color = C.Cyan,
		}, VFX)
		local core = make("Part", {
			Name = "StrikeCore", Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(500, 3.5, 3.5),
			CFrame = beam.CFrame,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			CastShadow = false, Material = Enum.Material.Neon, Color = C.White,
		}, VFX)
		make("PointLight", { Color = C.Cyan, Brightness = 20, Range = 80 }, core)

		impactAt(pos, normal, C.Cyan, 4.5, g and g.Instance)
		explosion(pos, C.White, 3, true)
		shockwave(pos + normal * 0.2, C.Cyan, 85, 1.2, 0.5, normal)
		task.delay(0.15, function() shockwave(pos + normal * 0.2, C.Gold, 60, 1.0, 0.4, normal) end)
		spawnDebris(pos + normal, Color3.fromRGB(110, 100, 90), 40, 70)
		dustAt(pos, Color3.fromRGB(190, 180, 170), 30, 40)
		for i = 1, 16 do
			local a = i / 16 * math.pi * 2
			lightning(pos, pos + Vector3.new(math.cos(a) * 40, rnd(2, 14), math.sin(a) * 40),
				C.Cyan, 0.4, 0.6, 7, 6)
		end
		screenFlash(C.White, 0.6, 1.1)
		addShake(1.2)
		S.FovKick = 10
		playSound(SND.Boom, { Position = pos, Volume = 1, Speed = 0.5, Range = 500, Reverb = true })
		playSound(SND.Boom, { Position = pos, Volume = 0.8, Speed = 0.8, Range = 500 })
		playSound(SND.Shot, { Position = pos, Volume = 0.8, Speed = 0.4, Range = 500 })

		tween(beam, 0.9, { Size = Vector3.new(500, 0.2, 0.2), Transparency = 1 })
		tween(core, 0.7, { Size = Vector3.new(500, 0.1, 0.1), Transparency = 1 })
		Debris:AddItem(beam, 1.1)
		Debris:AddItem(core, 1.1)
	end)
end

--========================================================
-- ARC OVERDRIVE
--========================================================

function overdrive()
	if not systemsReady() or S.Busy then return end
	if os.clock() - S.Last.Overdrive < CFG.OverdriveCooldown then
		setStatus("OVERDRIVE COOLING DOWN")
		playSound(SND.Click, { Volume = 0.6, Speed = 0.5 })
		return
	end
	if not spend(CFG.OverdriveCost) then return end

	S.Busy = true
	S.Last.Overdrive = os.clock()
	setStatus("WARNING // ARC OVERDRIVE ENGAGED")

	local sweep = playSound(SND.Ping, { Volume = 0.8, Speed = 0.4, Life = 2 })
	if sweep then tween(sweep, 0.3, { PlaybackSpeed = 2.4 }) end

	glowBall(Root.Position, 5, C.White, 0.4)
	screenFlash(C.Cyan, 0.35, 0.8)
	addShake(1)
	if ReactorLight then ReactorLight.Brightness = 14 ReactorLight.Range = 36 end

	task.wait(0.3)
	if not S.Suit or not Root then S.Busy = false return end
	local center = Root.Position

	playSound(SND.Boom, { Volume = 1, Speed = 0.55, Range = 300, Reverb = true })
	playSound(SND.Metal, { Volume = 0.7, Speed = 0.5 })
	shockwave(center, C.Cyan, 55, 1.0, 0.3)
	task.delay(0.15, function() shockwave(center, C.Gold, 40, 0.9, 0.25) end)
	explosion(center, C.Cyan, 2, true)

	for i = 1, 28 do
		local a = i / 28 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local tip = center + dir * rnd(18, 40) + Vector3.new(0, rnd(-4, 14), 0)
		lightning(center, tip, (i % 2 == 0) and C.Gold or C.Cyan, 0.25, 0.65, 6, 4)
	end

	S.OverdriveUntil = os.clock() + CFG.OverdriveDuration
	S.Energy = math.min(CFG.MaxEnergy, S.Energy + 25)
	S.FovKick = 12

	task.wait(0.6)
	S.Busy = false
end

--========================================================
-- FLIGHT
--========================================================

local function stopFlight(reason)
	if not S.Flying then return end
	S.Flying = false
	S.Boosting = false
	S.BoostActive = false
	S.LeanDeg = 0
	S.SpeedAlpha = 0

	for _, obj in ipairs({ FlightVelocity, FlightOrientation, FlightAttachment }) do
		if obj then obj:Destroy() end
	end
	FlightVelocity, FlightOrientation, FlightAttachment = nil, nil, nil

	for _, t in ipairs(Thrusters) do
		t.Emitter.Enabled = false
		t.Trail.Enabled = false
	end
	S.LoopTarget.Flight = 0

	if Humanoid then
		Humanoid.PlatformStand = false
		Humanoid.AutoRotate = true
		Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	S.Vel = Vector3.zero
	playSound(SND.Whoosh, { Volume = 0.4, Speed = 0.7 })
	setStatus(reason or "FLIGHT OFF")
end

local function startFlight()
	if not S.Suit then
		setStatus("FLIGHT LOCKED // DEPLOY SUIT")
		playSound(SND.Click, { Volume = 0.6, Speed = 0.5 })
		return
	end
	if not systemsReady() then return end
	if S.Flying or not Root or not Humanoid then return end
	if S.Energy < 5 then setStatus("INSUFFICIENT ENERGY") return end

	S.Flying = true
	S.Facing = false
	Humanoid.AutoRotate = false
	Humanoid.PlatformStand = true

	FlightAttachment = make("Attachment", { Name = "JARVIS_FlightAttachment" }, Root)
	FlightVelocity = make("LinearVelocity", {
		Name = "JARVIS_FlightVelocity", Attachment0 = FlightAttachment,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		VectorVelocity = Vector3.zero, MaxForce = 1e6,
	}, Root)
	FlightOrientation = make("AlignOrientation", {
		Name = "JARVIS_FlightOrientation", Attachment0 = FlightAttachment,
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		Responsiveness = 18, MaxTorque = 1e6,
		CFrame = Root.CFrame.Rotation,
	}, Root)

	S.Vel = Vector3.new(0, 28, 0)
	local feet = Root.Position - Vector3.new(0, 2.8, 0)
	shockwave(feet, C.Cyan, 16, 0.5, 0.2)
	particlesAt(feet, C.Cyan, 40, 22)
	dustAt(feet, Color3.fromRGB(190, 185, 180), 8, 18)
	for _, t in ipairs(Thrusters) do t.Emitter.Enabled = true end
	playSound(SND.Whoosh, { Volume = 0.9, Speed = 1.3 })
	playSound(SND.Boom, { Volume = 0.4, Speed = 1.5 })
	addShake(0.3)
	S.FovKick = 8
	setStatus("FLIGHT ONLINE // THRUSTERS ACTIVE")
end

function toggleFlight()
	if S.Flying then stopFlight("FLIGHT OFF") else startFlight() end
end

local function moveInput()
	if Controls then
		local ok, v = pcall(function() return Controls:GetMoveVector() end)
		if ok and v then return -v.Z, v.X end
	end
	local f, r = 0, 0
	if UIS:IsKeyDown(Enum.KeyCode.W) then f += 1 end
	if UIS:IsKeyDown(Enum.KeyCode.S) then f -= 1 end
	if UIS:IsKeyDown(Enum.KeyCode.D) then r += 1 end
	if UIS:IsKeyDown(Enum.KeyCode.A) then r -= 1 end
	return f, r
end

local function updateFlight(dt)
	local cam = workspace.CurrentCamera
	local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
	local fwdIn, sideIn = moveInput()

	local vert = 0
	if UIS:IsKeyDown(Enum.KeyCode.Space) or S.TouchUp then vert += 1 end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or S.TouchDown then vert -= 1 end

	local dir = look * fwdIn + right * sideIn + Vector3.new(0, vert, 0)
	if dir.Magnitude > 1 then dir = dir.Unit end

	local speed = CFG.FlightSpeed
	local boosting = S.Boosting and dir.Magnitude > 0.1
	if boosting then
		speed = CFG.BoostSpeed * (overdriveActive() and 1.25 or 1)
	end

	if boosting and not S.BoostActive then
		playSound(SND.Boom, { Volume = 0.7, Speed = 0.6, Reverb = true })
		shockwave(Root.Position, C.White, 20, 0.5, 0.15, look)
		shockwave(Root.Position - look * 3, C.Cyan, 14, 0.6, 0.12, look)
		addShake(0.4)
		S.FovKick = 12
	end
	S.BoostActive = boosting

	local target = dir * speed
	if dir.Magnitude < 0.05 then
		target = Vector3.new(0, math.sin(os.clock() * 2) * 1.5, 0)
	end

	S.Vel = S.Vel:Lerp(target, 1 - math.exp(-CFG.Accel * dt))
	FlightVelocity.VectorVelocity = S.Vel

	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.01 then flatLook = Root.CFrame.LookVector * Vector3.new(1, 0, 1) end
	local yaw = CFrame.lookAt(Vector3.zero, flatLook.Unit)
	local speedAlpha = math.clamp(S.Vel.Magnitude / CFG.BoostSpeed, 0, 1)
	local pitchSign = (look.Y > 0.5 and vert >= 0 and fwdIn > 0) and 0.5 or 1
	local lean = math.rad(CFG.MaxLean) * speedAlpha * pitchSign * (fwdIn > 0.1 and 1 or 0.3)
	local bank = -sideIn * CFG.BankAmount * speedAlpha
	FlightOrientation.CFrame = yaw * CFrame.Angles(-lean, 0, bank)
	S.LeanDeg = math.deg(lean)
	S.SpeedAlpha = speedAlpha

	local rate = 40 + speedAlpha * 120 + (boosting and 80 or 0)
	for _, t in ipairs(Thrusters) do
		t.Emitter.Rate = rate
		t.Emitter.Speed = NumberRange.new(10 + speedAlpha * 25)
		t.Trail.Enabled = boosting
	end
	S.LoopTarget.Flight = 0.25 + speedAlpha * 0.6 + (boosting and 0.2 or 0)
	if Loops.Flight then
		Loops.Flight.PlaybackSpeed = 0.8 + speedAlpha * 0.7 + (boosting and 0.2 or 0)
	end

	-- ground effect: low flight kicks up dust
	if os.clock() - S.LastGroundFx > 0.12 then
		S.LastGroundFx = os.clock()
		local g = workspace:Raycast(Root.Position, Vector3.new(0, -16, 0), rayParams())
		if g then
			local close = 1 - (Root.Position.Y - g.Position.Y) / 16
			dustAt(g.Position + Vector3.new(0, 0.5, 0), g.Instance.Color:Lerp(Color3.new(1, 1, 1), 0.4),
				math.floor(2 + close * 5), 8 + close * 14)
		end
	end

	-- landing assist
	if S.Vel.Y < -4 then
		local hit = workspace:Raycast(Root.Position, Vector3.new(0, -5.5, 0), rayParams())
		if hit then
			local impact = hit.Position
			stopFlight("LANDING COMPLETE")
			shockwave(impact + Vector3.new(0, 0.2, 0), C.Cyan, 14, 0.5, 0.2)
			particlesAt(impact, C.White, 25, 14)
			dustAt(impact, Color3.fromRGB(190, 185, 180), 14, 20)
			spawnDebris(impact, hit.Instance.Color, 8, 18)
			playSound(SND.Boom, { Position = impact, Volume = 0.5, Speed = 1.4 })
			addShake(0.3)
			return
		end
	end

	local drain = CFG.FlightDrain + (boosting and CFG.BoostDrain or 0)
	if overdriveActive() then drain *= 0.4 end
	S.Energy -= drain * dt
	if S.Energy <= 0 then
		S.Energy = 0
		playSound(SND.Ping, { Volume = 0.8, Speed = 0.4 })
		stopFlight("ENERGY DEPLETED // FLIGHT OFFLINE")
	end
end

