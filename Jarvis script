local function frame(parent, props)
	props.BorderSizePixel = 0
	if props.BackgroundTransparency == nil then props.BackgroundTransparency = 1 end
	return make("Frame", props, parent)
end

local function stroke(parent, color, thickness, transparency)
	return make("UIStroke", {
		Color = color or C.Cyan, Thickness = thickness or 1.5, Transparency = transparency or 0.2,
	}, parent)
end

local function label(parent, text, pos, size, color, textSize, align)
	return make("TextLabel", {
		Position = pos, Size = size, BackgroundTransparency = 1,
		Text = text, Font = Enum.Font.Code, TextSize = textSize, TextColor3 = color,
		TextXAlignment = align or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, parent)
end

local function bar(parent, y, color, height)
	local back = frame(parent, {
		Position = UDim2.fromOffset(13, y), Size = UDim2.new(1, -26, 0, height),
		BackgroundColor3 = Color3.fromRGB(30, 40, 55), BackgroundTransparency = 0,
	})
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, back)
	local fill = frame(parent, {})
	fill.Parent = back
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = color
	fill.BackgroundTransparency = 0
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	return fill
end

local function touchButton(parent, text, pos, onDown, onUp)
	local b = make("TextButton", {
		Text = text, Font = Enum.Font.Code, TextSize = 14, TextColor3 = C.Cyan,
		BackgroundColor3 = Color3.fromRGB(5, 12, 23), BackgroundTransparency = 0.25,
