local function spend(cost)
	if overdriveActive() then cost = cost * 0.5 end
	if S.Energy < cost then
		setStatus("INSUFFICIENT ENERGY")
		playSound(SND.Click, { Volume = 0.6, Speed = 0.5 })
		return false
	end
	S.Energy -= cost
	return true
end

local function systemsReady()
	if not S.Suit then return false end
	if S.Deploying then
		setStatus("SYSTEMS INITIALIZING")
		return false
	end
	return true
end

