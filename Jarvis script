local function glowBall(position, size, color, duration)
	local part = make("Part", {
		Name = "Glow", Shape = Enum.PartType.Ball,
		Size = Vector3.one * size, CFrame = CFrame.new(position),
		Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		CastShadow = false, Material = Enum.Material.Neon, Color = color,
	}, VFX)
	tween(part, duration, { Size = Vector3.one * 0.05, Transparency = 1 })
	Debris:AddItem(part, duration + 0.15)
	return part
end

local function beamBetween(a, b, color, thickness, duration)
	local length = (b - a).Magnitude
	if length < 0.05 then return end
	local beam = make("Part", {
		Name = "Beam", Size = Vector3.new(thickness, thickness, length),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		CastShadow = false, Material = Enum.Material.Neon, Color = color,
	}, VFX)
	tween(beam, duration, { Transparency = 1, Size = Vector3.new(0.02, 0.02, length) })
	Debris:AddItem(beam, duration + 0.15)
end

-- jagged lightning arc between two points
local function lightning(a, b, color, thickness, duration, segments, jitter)
	segments = segments or 8
	local dir = b - a
	if dir.Magnitude < 0.5 then return end
	local unit = dir.Unit
	local p1 = unit:Cross(Vector3.yAxis)
	if p1.Magnitude < 0.1 then p1 = unit:Cross(Vector3.xAxis) end
	p1 = p1.Unit
	local p2 = unit:Cross(p1)
	local prev = a
	for i = 1, segments do
		local p = a + dir * (i / segments)
		if i < segments then
			p += p1 * (math.random() - 0.5) * jitter + p2 * (math.random() - 0.5) * jitter
		end
		beamBetween(prev, p, color, thickness, duration)
		prev = p
	end
end

