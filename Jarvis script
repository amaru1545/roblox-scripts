function startUnibeam()
	if not systemsReady() or S.Unibeam or S.Busy then return end
	if S.Energy < 12 then
		setStatus("INSUFFICIENT ENERGY")
		return
	end
	S.Unibeam = true
	S.UniTick = 0
	local function bp(color, size)
		return make("Part", {
			Name = "Unibeam", Size = Vector3.new(size, size, 1),
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			CastShadow = false, Material = Enum.Material.Neon, Color = color,
		}, VFX)
	end
	UniOuter = bp(C.Cyan, 1.6)
	UniInner = bp(C.White, 0.7)
	UniGlow = make("Part", {
		Name = "UnibeamGlow", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4,
		Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		CastShadow = false, Material = Enum.Material.Neon, Color = C.White, Transparency = 0.2,
	}, VFX)
	make("PointLight", { Color = C.Cyan, Brightness = 10, Range = 28 }, UniGlow)
	S.LoopTarget.Beam = 0.7
	playSound(SND.Boom, { Volume = 0.5, Speed = 1.6 })
	setStatus("UNIBEAM ACTIVE")
end

function stopUnibeam()
	if not S.Unibeam then return end
	S.Unibeam = false
	S.LoopTarget.Beam = 0
	for _, p in ipairs({ UniOuter, UniInner, UniGlow }) do
		if alive(p) then
			tween(p, 0.25, { Transparency = 1 })
			Debris:AddItem(p, 0.3)
		end
	end
	UniOuter, UniInner, UniGlow = nil, nil, nil
	playSound(SND.Ping, { Volume = 0.5, Speed = 0.6 })
	setStatus("UNIBEAM OFFLINE")
end

local function updateUnibeam(dt)
	if not (UniOuter and UniInner and UniGlow) then return end
	local origin = Reactor and Reactor.Position or Root.Position
	local dest, hit = aimPoint(280)
	local len = (dest - origin).Magnitude
	if len < 1 then return end
	local mid = CFrame.lookAt((origin + dest) / 2, dest)
	local pulse = 1 + math.sin(clock * 55) * 0.15
	UniOuter.Size = Vector3.new(1.6 * pulse, 1.6 * pulse, len)
	UniOuter.CFrame = mid
	UniInner.Size = Vector3.new(0.7 * pulse, 0.7 * pulse, len)
	UniInner.CFrame = mid
	UniGlow.CFrame = CFrame.new(origin)
	UniGlow.Size = Vector3.one * (2.4 * pulse)

	S.Energy -= CFG.UnibeamDrain * (overdriveActive() and 0.4 or 1) * dt
	addShake(0.012)

	S.UniTick += dt
	if S.UniTick > 0.09 then
		S.UniTick = 0
		particlesAt(dest, C.White, 10, 22)
		lightning(origin, dest, C.Cyan, 0.12, 0.12, 9, 2.5)
		if hit then
			spawnDebris(dest + hit.Normal * 0.3, hit.Instance.Color, 2, 20)
			if math.random() < 0.25 then
				impactAt(dest, hit.Normal, C.Cyan, 0.6, hit.Instance, true)
			end
		end
	end

	if S.Energy <= 0 then
		S.Energy = 0
		stopUnibeam()
	end
end

