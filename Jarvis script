local function playSound(id, o)
	if S.Muted then return end
	o = o or {}
	local parent, holder = o.Parent, nil
	if not parent then
		if o.Position then
			holder = make("Part", {
				Transparency = 1, Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, Size = Vector3.one * 0.2,
				Position = o.Position,
			}, VFX)
			parent = holder
		else
			parent = Root
		end
	end
	if not parent then return end
	local snd = make("Sound", {
		SoundId = id,
		Volume = (o.Volume or 0.6) * CFG.Volume,
		PlaybackSpeed = o.Speed or 1,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 10,
		RollOffMaxDistance = o.Range or 200,
	}, parent)
	if o.Reverb then
		make("ReverbSoundEffect", {
			DecayTime = 2.2, Density = 1, Diffusion = 1, DryLevel = 0, WetLevel = -5,
		}, snd)
	end
	snd:Play()
	Debris:AddItem(holder or snd, o.Life or 4)
	return snd
end

local function createLoops()
	local defs = {
		Hum = { SND.Ping, 0.3 },
		Flight = { SND.Whoosh, 1 },
		Charge = { SND.Ping, 1 },
		Beam = { SND.Whoosh, 2.3 },
		Shield = { SND.Ping, 0.22 },
	}
	for name, d in pairs(defs) do
		local s = make("Sound", {
			Name = "JARVIS_Loop_" .. name, SoundId = d[1], Looped = true,
			Volume = 0, PlaybackSpeed = d[2], RollOffMaxDistance = 160,
		}, Root)
		s:Play()
		Loops[name] = s
	end
end

local function destroyLoops()
	for name, s in pairs(Loops) do
		if alive(s) then s:Destroy() end
		Loops[name] = nil
	end
	for k in pairs(S.LoopTarget) do S.LoopTarget[k] = 0 end
end

local function updateLoops(dt)
	for name, s in pairs(Loops) do
		if alive(s) then
			local target = S.Muted and 0 or (S.LoopTarget[name] or 0) * CFG.Volume
			s.Volume += (target - s.Volume) * math.clamp(dt * 8, 0, 1)
		end
	end
end

