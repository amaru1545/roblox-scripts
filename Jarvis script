-- called every frame while the suit is assembling
local function stepDeploy()
	if not S.Deploying then return end
	local now = os.clock() - S.DeployStart
	local pending = 0
	for _, r in ipairs(Pieces) do
		if not r.Done then
			local p = r.Part
			if not alive(p) or not alive(r.Body) then
				r.Done = true
			else
				local t = (now - r.Delay) / r.Dur
				if t >= 0 then
					t = math.min(t, 1)
					local e = 1 - (1 - t) ^ 3
					local final = r.Body.CFrame * r.Offset
					p.CFrame = r.Start:Lerp(final, e)
					p.Transparency = 1 + (r.Final - 1) * math.min(t * 3, 1)
					if t >= 1 then
						p.CFrame = final
						p.Anchored = false
						p.Parent = Character
						make("WeldConstraint", { Part0 = r.Body, Part1 = p }, p)
						table.insert(Armor, p)
						r.Done = true
						if math.random() < 0.35 then
							particlesAt(p.Position, C.Gold, 4, 9)
						end
						if os.clock() - S.LastClank > 0.11 then
							S.LastClank = os.clock()
							playSound(SND.Metal, { Volume = 0.35, Speed = rnd(0.7, 1.5) })
						end
					else
						pending += 1
					end
				else
					pending += 1
				end
			end
		end
	end
	if pending == 0 then
		S.Deploying = false
		if S.Suit then
			SuitHighlight = make("Highlight", {
				Name = "JARVIS_EnergyAura", Adornee = Character,
				FillColor = C.Cyan, OutlineColor = C.Gold,
				FillTransparency = 0.93, OutlineTransparency = 0.15,
				DepthMode = Enum.HighlightDepthMode.Occluded,
			}, Character)
			screenFlash(C.Cyan, 0.25, 0.7)
			shockwave(Root.Position - Vector3.new(0, 2.8, 0), C.Cyan, 22, 0.7, 0.2)
			glowBall(Root.Position, 7, C.White, 0.4)
			playSound(SND.Boom, { Volume = 0.6, Speed = 1.1, Reverb = true })
			local sweep = playSound(SND.Ping, { Volume = 0.8, Speed = 0.5, Life = 2 })
			if sweep then tween(sweep, 0.5, { PlaybackSpeed = 2.4 }) end
			S.FovKick = 14
			addShake(0.5)
			setStatus("MARK ∞ ONLINE // ALL SYSTEMS NOMINAL")
		end
	end
end

local function clearArmor(animated)
	restorePose()
	destroyLoops()

	for _, r in ipairs(Pieces) do
		if not r.Done and alive(r.Part) then r.Part:Destroy() end
	end
	table.clear(Pieces)

	for _, p in ipairs(Armor) do
		if alive(p) then
			if animated then
				local w = p:FindFirstChildOfClass("WeldConstraint")
				if w then w:Destroy() end
				local cf = p.CFrame
				p.Anchored = true
				p.Parent = VFX
				for _, ch in ipairs(p:GetChildren()) do
					if ch:IsA("PointLight") or ch:IsA("ParticleEmitter") or ch:IsA("Attachment") then ch:Destroy() end
				end
				tween(p, 0.7, {
					CFrame = cf * CFrame.new(rnd(-1, 1) * 24, rnd(-0.2, 1) * 24, rnd(-1, 1) * 24)
						* CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6)),
					Transparency = 1,
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				Debris:AddItem(p, 0.9)
			else
				p:Destroy()
			end
		end
	end
	table.clear(Armor)

	for _, t in ipairs(Thrusters) do
		for _, a in ipairs(t.Attachments) do
			if alive(a) then a:Destroy() end
		end
		if alive(t.Trail) then t.Trail:Destroy() end
	end
	table.clear(Thrusters)
	Reactor, ReactorLight, ChargeOrb, ChargeLight, PalmEmitter = nil, nil, nil, nil, nil
	if SuitHighlight then SuitHighlight:Destroy() SuitHighlight = nil end
end

