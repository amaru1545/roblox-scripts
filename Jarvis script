local function suitUp()
	if S.Suit or not Character or not Character.Parent then return end
	S.Suit = true
	S.Deploying = true
	S.DeployStart = os.clock()

	createArmor()
	setupShoulders()
	createLoops()

	playSound(SND.Whoosh, { Volume = 0.9, Speed = 0.8 })
	playSound(SND.Ping, { Volume = 0.6, Speed = 0.5 })
	S.FovKick = 10
	addShake(0.2)
	setStatus("ARMOR ASSEMBLY IN PROGRESS")

	local name = string.upper(Player.DisplayName)
	bootLog({
		"> J.A.R.V.I.S. // MARK ∞",
		"> ARMOR LINK ............. SYNCING",
		"> ARC REACTOR ............ 100%",
		"> REPULSORS .............. ARMED",
		"> FLIGHT SYSTEMS ......... READY",
		"> WELCOME BACK, " .. name,
	})
end

local function suitDown(reason, silent, instant)
	stopFlight("FLIGHT OFF")
	stopUnibeam()
	setShield(false)
	local wasOn = S.Suit
	S.Suit = false
	S.Deploying = false
	S.Charging = false
	S.Busy = false
	S.Target, S.TargetInfo = nil, nil
	S.OverdriveUntil = 0
	S.AimUntil = 0
	S.BootToken += 1
	if Gui.Log then Gui.Log.Text = "" end
	if S.Facing and Humanoid then Humanoid.AutoRotate = true end
	S.Facing = false
	if wasOn and not silent then
		playSound(SND.Metal, { Volume = 0.7, Speed = 0.5 })
		playSound(SND.Whoosh, { Volume = 0.7, Speed = 1.2 })
	end
	clearArmor(wasOn and not instant)
	setStatus(reason or "SYSTEM STANDBY // ARMOR RETRACTED")
end

function suitToggle()
	if S.Suit then suitDown() else suitUp() end
end

function emergency()
	if S.Suit then
		suitDown("EMERGENCY SHUTDOWN")
		screenFlash(C.Warn, 0.15, 0.5)
	end
end

