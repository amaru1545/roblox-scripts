-- Reapply values if they are reset while enabled
task.spawn(function()
    while ScreenGui.Parent do
        if Enabled then
            SetValues(true)
        end
        task.wait(0.5)
    end
end)

-- Slap loop
task.spawn(function()
    while ScreenGui.Parent do
        if Enabled then
            local event = GetEvent()

            if event then
                for _, player in ipairs(Players:GetPlayers()) do
                    if not Enabled then
                        break
                    end

                    if player ~= LocalPlayer and player.Character then
                        pcall(function()
                            event:FireServer(
                                "slash",
                                player.Character,
                                Vector3.new(
                                    math.huge,
                                    -100,
                                    math.huge
                                )
                            )
                        end)

                        task.wait()
                    end
                end
            else
                task.wait(0.5)
            end
        else
            task.wait(0.05)
        end

        task.wait()
    end
end)

