    FlightSpeed = 99999999999,
    Speed = 0.1
}

-- Find SlapHand and its RemoteEvent
local function GetSlapHand()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end
    return backpack:FindFirstChild("SlapHand")
end

local function GetEvent()
    local tool = GetSlapHand()
    return tool and tool:FindFirstChild("Event")
end

-- Save and apply values
local function SetValues(enable)
    local tool = GetSlapHand()
    if not tool then
        warn("Kick Slap (All): SlapHand not found")
        return
    end

    for name, target in pairs(TargetValues) do
        local obj = tool:FindFirstChild(name)

        if obj and obj:IsA("NumberValue") then
            if enable then
                if OriginalValues[obj] == nil then
                    OriginalValues[obj] = obj.Value
                end
                obj.Value = target
            elseif OriginalValues[obj] ~= nil then
                obj.Value = OriginalValues[obj]
                OriginalValues[obj] = nil
            end
        end
    end
end

